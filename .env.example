# Public frontend configuration; no secrets. Restart dev/build after changes.
# Optional: without it `npm run dev` uses http://localhost:8080/api and `npm run build` uses
# https://skygo-backend.onrender.com/api. The backend must list the admin's origin in
# CORS_ALLOWED_ORIGINS (e.g. http://localhost:8000 for dev).
SKYGO_API_BASE_URL=http://localhost:8080/api
